{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memdb",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "PUBLIC_ORIGIN": "http://127.0.0.1:8787" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "memdb",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [
    { "name": "REQUEST_LIMITER", "namespace_id": "41001", "simple": { "limit": 1200, "period": 60 } },
    { "name": "READ_LIMITER", "namespace_id": "41002", "simple": { "limit": 60, "period": 60 } },
    { "name": "WRITE_LIMITER", "namespace_id": "41003", "simple": { "limit": 10, "period": 60 } },
    { "name": "CREATE_LIMITER", "namespace_id": "41004", "simple": { "limit": 20, "period": 60 } }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": false }
}
