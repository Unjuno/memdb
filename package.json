{
  "name": "memdb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1",
    "build": "tsc -p tsconfig.json",
    "test:core": "tsc -p tsconfig.core.json && node --experimental-sqlite --test tests/core.test.mjs",
    "test:mcp": "npm run build && node --experimental-sqlite --test tests/mcp.test.mjs",
    "test": "npm run test:core && npm run test:mcp",
    "db:local": "wrangler d1 migrations apply memdb --local",
    "deploy": "wrangler deploy"
  },
  "dependencies": { "@modelcontextprotocol/server": "^2.0.0", "zod": "^4.2.0" },
  "devDependencies": { "typescript": "5.8.3", "wrangler": "^4.0.0" }
}
